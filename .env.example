# ─────────────────────────────────────────────────────────────────────────────
# FullSend — environment
#
# Copy to .env.local and fill in what you need. FullSend runs with almost none
# of this set: it falls back to an in-memory database, a local dev session and
# a deterministic content composer, and the app tells you on every page which
# capabilities are actually live.
#
# The three things you must set before FullSend can publish for real are:
#   FULLSEND_ENCRYPTION_KEY, Supabase (database + storage), and one platform.
# ─────────────────────────────────────────────────────────────────────────────


# ── Core ─────────────────────────────────────────────────────────────────────

# Public URL of this deployment. Must match the OAuth redirect URIs you register
# with Meta and TikTok, exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypts platform OAuth tokens at rest (AES-256-GCM). Required before any
# account can be connected. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FULLSEND_ENCRYPTION_KEY=

# Emails allowed into the FullSend Control Room (/admin). Comma separated.
FULLSEND_ADMIN_EMAILS=


# ── Database, auth and storage (Supabase) ────────────────────────────────────
#
# Create a project at supabase.com, then run supabase/migrations/0001_*.sql in
# the SQL editor. Without these, FullSend uses an in-memory store that resets
# whenever the server restarts — fine for a look around, not for real use.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# A PUBLIC storage bucket. Instagram and TikTok fetch media from a URL, so
# generated creative has to be hosted somewhere they can reach.
SUPABASE_STORAGE_BUCKET=fullsend-creative

# Force a driver. Leave unset to auto-detect: supabase when the service-role
# key is present, memory otherwise.
# FULLSEND_DB_DRIVER=supabase


# ── AI ───────────────────────────────────────────────────────────────────────
#
# Set one. With neither, FullSend uses its deterministic composer: real,
# usable output composed from your repository by rules rather than a model.
# The UI reports the provider as `deterministic` so nothing is misrepresented.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# anthropic | openai | mock. Defaults to whichever key is present.
# FULLSEND_AI_PROVIDER=anthropic

# Hard monthly spend cap in USD. Generation stops when it is reached;
# publishing of already-generated content carries on.
FULLSEND_AI_MONTHLY_BUDGET_USD=50

# Override the OpenAI model ids if the defaults go stale.
# OPENAI_MODEL_FAST=gpt-4.1-mini
# OPENAI_MODEL_STANDARD=gpt-4.1
# OPENAI_MODEL_PREMIUM=gpt-4.1


# ── GitHub ───────────────────────────────────────────────────────────────────
#
# A token lifts the anonymous rate limit and lets FullSend read private repos.
# A classic PAT with `repo` scope, or a fine-grained token with read access.

GITHUB_TOKEN=

# Only needed if you want users to connect their own GitHub account.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_API_BASE=https://api.github.com


# ── Instagram (Meta) ─────────────────────────────────────────────────────────
#
# Requires: an Instagram BUSINESS account linked to a Facebook Page, a Meta app
# with the Instagram product added, and `instagram_business_content_publish`
# approved through App Review (2–4 weeks).
#
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/accounts/instagram/callback
#
# FullSend → Accounts walks through every step with the values to paste.

META_APP_ID=
META_APP_SECRET=

# facebook_login (default, uses a Page token) or instagram_login.
# META_LOGIN_MODE=facebook_login

# Bump when Meta deprecates the version you are on.
# META_GRAPH_VERSION=v23.0
# META_GRAPH_HOST=https://graph.facebook.com
# INSTAGRAM_GRAPH_HOST=https://graph.instagram.com


# ── TikTok ───────────────────────────────────────────────────────────────────
#
# Requires: a TikTok developer app with the Content Posting API and Login Kit,
# the `video.publish` scope, your media domain verified under URL Prefix
# Verification, and the content-posting audit passed (2–4 weeks).
#
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/accounts/tiktok/callback
#
# IMPORTANT: until the audit passes, every API post is forced to SELF_ONLY —
# visible only to the connected creator. FullSend says so on each affected post
# rather than implying it went live.

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Set true ONLY after TikTok has audited your client. Until then FullSend
# publishes SELF_ONLY and labels it.
TIKTOK_CLIENT_AUDITED=false

# TIKTOK_API_HOST=https://open.tiktokapis.com
# TIKTOK_AUTH_HOST=https://www.tiktok.com


# ── Background jobs ──────────────────────────────────────────────────────────
#
# Every /api/cron/* endpoint requires this. With it unset, the cron endpoints
# refuse every request rather than running unauthenticated.
#
# Send it as: Authorization: Bearer <secret>
#
# Schedules (see vercel.json):
#   /api/cron/queue    every minute    drain the job queue
#   /api/cron/publish  every 5 minutes publish anything due
#   /api/cron/daily    daily           the full autopilot loop
#   /api/cron/weekly   weekly          the Weekly Send Report
#   /api/cron/health   every 6 hours   token refresh + connection checks

CRON_SECRET=

# How many times a failed job is retried before it is marked dead (and logged
# to the Control Room — never silently dropped).
FULLSEND_JOB_MAX_ATTEMPTS=5


# ── Video rendering (optional) ───────────────────────────────────────────────
#
# With no provider, FullSend produces a complete production package — hook,
# scenes, timings, narration, on-screen text, music direction — and says
# plainly that no file was rendered. TikTok needs an actual video file, so
# without this you upload the finished video yourself.

# none | shotstack | creatomate
FULLSEND_VIDEO_PROVIDER=none
FULLSEND_VIDEO_API_KEY=


# ── Billing (optional) ───────────────────────────────────────────────────────
#
# With no Stripe key, billing is off and every account gets the full product
# with no limits enforced. The architecture is ready; turn it on when you want.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SEND=
STRIPE_PRICE_FULL_SEND=
STRIPE_PRICE_AGENCY=
